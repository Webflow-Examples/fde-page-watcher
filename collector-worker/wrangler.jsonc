{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fde-page-collector",
  "main": "index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "PAGESPEED_API_KEY",
      "CRUX_API_KEY",
      "CRON_SECRET",
      "WEBFLOW_TOKEN_ENCRYPTION_KEY"
    ]
  },
  "vars": {
    "NIGHTLY_TENANT": "brand-studio:live",
    // Where the app answers, so the links in a digest work from a mail client.
    // Left empty the digest still sends, with root-relative links that visibly
    // do not resolve — deliberately, so a deployment that has not been told its
    // own address fails where someone can see it rather than sending links that
    // quietly resolve against whatever opened them.
    "PUBLIC_APP_URL": "",
    // Deployment gate for outbound external agent-readiness scans. Scans are
    // public, so this stays "false" until a deployment deliberately enables the
    // user-triggered refresh. A project's own consent record is checked too.
    "ORA_SCAN_ENABLED": "false"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "30 5 * * 1",
      "15 6 * * 2",
      // External agent-audit refresh. Deliberately separate from every
      // collection cron so it can never affect a Page Watch collection.
      "45 6 * * 3"
    ]
  },
  "workflows": [
    {
      "binding": "COLLECTION_WORKFLOW",
      "name": "fde-page-collection",
      "class_name": "CollectorWorkflow"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "page-watcher-fde",
      "database_id": "b717842d-d780-4f62-936b-f928c93b5f29",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "page-watcher-reports"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
