{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fde-page-watcher-gateway",
  "main": "index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ORIGIN_URL": "https://page-watcher.webflow.io",
    "AUTH_CALLBACK_URL": "https://page-watcher.webflow.io/api/auth/callback",
    "CF_ACCESS_TEAM_DOMAIN": "https://fde-webflow.cloudflareaccess.com",
    "CF_ACCESS_AUD": "69dba8551a2d8eb477453d86c1e8c9179389869faa68cc7ae52ac219c9204995"
  },
  "secrets": {
    "required": ["AUTH_HANDOFF_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
