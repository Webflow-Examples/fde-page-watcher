# Copy to .env.local and fill in as needed. All are optional for local dev.

# PageSpeed Insights API key — raises quota/reliability. PSI works keyless at
# low volume, so this is optional. https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Chrome UX Report API key. The collector Worker requires a key with the
# Chrome UX Report API enabled for weekly URL/origin field-data collection.
CRUX_API_KEY=

# Number of PSI runs per strategy (1–5). Defaults to 5 (the spec). Set to 1 for
# quick manual checks so a "Run now" completes in seconds.
PSI_RUNS=5

# Slack incoming webhook for 2/7/30-day follow-up reports.
SLACK_WEBHOOK_URL=

# Shared secret required to POST /api/cron/nightly outside development.
CRON_SECRET=

# Dataset namespace. `demo` keeps the bundled sample state; `live` uses an
# isolated empty tenant so switching back to demo is reversible.
DATASET_MODE=demo

# Ordered project allowlist. The first project is the default. Omit this to
# retain the single Brand Studio project. Tenant keys remain server-only.
# PAGE_WATCH_PROJECTS=[{"id":"brand-studio","name":"Brand Studio","tenant":"brand-studio:live"},{"id":"marketing","name":"Marketing","tenant":"marketing:live"}]

# Local-only identity used when no page-watch-dev-email cookie has been selected.
# Production never accepts this override and requires a verified Access JWT.
DEV_USER_EMAIL=matthew@webflow.com

# Cloudflare Access application identity verification. CF_ACCESS_TEAM_DOMAIN
# may be either the team hostname or its full https:// URL. CF_ACCESS_AUD is
# the Access application's AUD tag (comma-separated values are accepted).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Deployed Workflow endpoint (normally https://fde-page-collector.<account>.workers.dev/jobs).
# The app polls this endpoint for status/results, so no inbound callback URL is
# needed and site-wide SSO can remain enabled.
COLLECTOR_URL=

# Optional explicit FDE Worker base URL. When omitted, it is derived by
# removing `/jobs` from COLLECTOR_URL.
FDE_DATA_URL=

# Collector-only AES-256 key used to encrypt each tenant's Webflow site token
# before it is stored in D1. Generate with: openssl rand -base64 32
# Configure this with `wrangler secret put WEBFLOW_TOKEN_ENCRYPTION_KEY`; never
# expose it to browser code.
WEBFLOW_TOKEN_ENCRYPTION_KEY=

# Webflow Cloud mount path, e.g. /page-watch. Client navigation/API calls are
# prefixed with it. A full URL is accepted and its path is used.
BASE_URL=

# Claude API key for the Watcher's dashboard narrative and per-recommendation
# explanations, generated once per nightly run. If unset, both fall back to
# the templated (non-AI) text/no summary. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Set to skip the real Anthropic call and return deterministic placeholder
# text — for local dev/testing without spending API budget.
ANTHROPIC_MOCK=
